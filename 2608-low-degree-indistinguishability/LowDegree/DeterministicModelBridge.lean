import LowDegree.DeterministicStatistical
import LowDegree.DeterministicWitnessAdapters
import LowDegree.RandomPlantFourier

/-!
# Identifying the two deterministic-plant presentations

The deterministic appendix describes the alternative by uniformly injecting
a graph on `m` vertices into `n` vertices.  The core planted-model API pads
that graph along the canonical inclusion and then applies a uniform ambient
permutation.  This file proves that these are exactly the same finite law,
not merely asymptotically equivalent.
-/

namespace LowDegree

noncomputable section

attribute [local instance] Classical.decEq Classical.propDecidable

/-- Mapping a graph through the canonical inclusion and then permuting it has
the same edge set as directly embedding the source edge set. -/
theorem permutedPlantEdges_map_castLE
    {m n : Nat} (hfit : m <= n) (G : SimpleGraph (Fin m))
    (sigma : Equiv.Perm (Fin n)) :
    permutedPlantEdges (G.map (Fin.castLEEmb hfit)) sigma =
      embedAmbientEdgeSet
        ((Fin.castLEEmb hfit).trans sigma.toEmbedding)
        (permutedPlantEdges G (Equiv.refl (Fin m))) := by
  classical
  ext e
  rw [mem_permutedPlantEdges_iff]
  simp only [permutedPlant, SimpleGraph.map_map,
    SimpleGraph.edgeSet_map]
  constructor
  · rintro ⟨a, ha, hea⟩
    have haSource : a ∈ (permutedPlant G (Equiv.refl (Fin m))).edgeSet := by
      simpa [permutedPlant, SimpleGraph.map_adj] using ha
    let a' : AmbientEdge m := ⟨a, by
      simpa only [SimpleGraph.edgeSet_top, Set.mem_setOf_eq] using
        G.not_isDiag_of_mem_edgeSet ha⟩
    rw [embedAmbientEdgeSet, Finset.mem_map]
    refine ⟨a', ?_, ?_⟩
    · exact (mem_permutedPlantEdges_iff G (Equiv.refl (Fin m)) a').2 haSource
    · apply Subtype.ext
      exact hea
  · intro he
    rw [embedAmbientEdgeSet, Finset.mem_map] at he
    rcases he with ⟨a, ha, hae⟩
    have haSource :=
      (mem_permutedPlantEdges_iff G (Equiv.refl (Fin m)) a).1 ha
    refine ⟨a.1, ?_, ?_⟩
    · simpa [permutedPlant, SimpleGraph.map_adj] using haSource
    · exact congrArg Subtype.val hae

/-- The law of the edge set of a fixed ambient graph after a uniform vertex
permutation. -/
noncomputable def uniformlyPermutedPlantEdgeLaw {n : Nat}
    (G : SimpleGraph (Fin n)) : FiniteLaw (Finset (AmbientEdge n)) :=
  (uniformPermutationLaw n).map (permutedPlantEdges G)

/-- Uniformly injecting a point-mass source graph is exactly uniform
permutation of its canonically padded copy. -/
theorem uniformlyInjected_dirac_eq_uniformlyPermuted_map_castLE
    {m n : Nat} (hfit : m <= n) (G : SimpleGraph (Fin m)) :
    uniformlyInjectedPlantLaw hfit
        (FiniteLaw.dirac (permutedPlantEdges G (Equiv.refl (Fin m)))) =
      uniformlyPermutedPlantEdgeLaw (G.map (Fin.castLEEmb hfit)) := by
  apply FiniteLaw.ext_mass
  funext B
  simp only [uniformlyInjectedPlantLaw, uniformlyPermutedPlantEdgeLaw,
    FiniteLaw.map_mass, FiniteLaw.product_mass, FiniteLaw.dirac_mass]
  simp_rw [permutedPlantEdges_map_castLE hfit G]
  rw [Fintype.sum_prod_type]
  trans ∑ A : Finset (AmbientEdge m),
      if A = permutedPlantEdges G (Equiv.refl (Fin m)) then
        ∑ sigma : Equiv.Perm (Fin n),
          if embedAmbientEdgeSet
                ((Fin.castLEEmb hfit).trans sigma.toEmbedding) A = B then
            (uniformPermutationLaw n).mass sigma else 0
      else 0
  · apply Finset.sum_congr rfl
    intro A _hAuniv
    by_cases hA : A = permutedPlantEdges G (Equiv.refl (Fin m))
    · subst A
      simp
    · simp [hA]
  · simp

/-- The random-forced likelihood generated by the uniform edge-set law is
definitionally the usual uniformly permuted planted-graph likelihood. -/
theorem randomForcedLikelihood_uniformlyPermutedPlantEdgeLaw
    {n : Nat} (theta : BernoulliParameter) (G : SimpleGraph (Fin n)) :
    randomForcedLikelihood theta (uniformlyPermutedPlantEdgeLaw G) =
      plantedLikelihood theta G := by
  funext x
  change (uniformlyPermutedPlantEdgeLaw G).expect
      (fun A => forcedLikelihood theta A x) = plantedLikelihood theta G x
  rw [uniformlyPermutedPlantEdgeLaw, FiniteLaw.expect_map]
  rfl

/-- The two presentations give exactly the same observation law. -/
theorem randomForcedLaw_uniformlyPermutedPlantEdgeLaw
    {n : Nat} (theta : BernoulliParameter) (G : SimpleGraph (Fin n)) :
    randomForcedLaw theta (uniformlyPermutedPlantEdgeLaw G) =
      plantedLaw theta G := by
  apply FiniteLaw.ext_mass
  funext x
  change bernoulliProductMass theta x *
      randomForcedLikelihood theta (uniformlyPermutedPlantEdgeLaw G) x =
    bernoulliProductMass theta x * plantedLikelihood theta G x
  rw [randomForcedLikelihood_uniformlyPermutedPlantEdgeLaw]

/-- Consequently the projected second moments in the random-set and graph
interfaces agree at every finite index and every cutoff. -/
theorem randomForcedLowDegreeNormSq_uniformlyPermutedPlantEdgeLaw
    {n : Nat} (theta : BernoulliParameter) (G : SimpleGraph (Fin n))
    (degreeCutoff : Nat) :
    randomForcedLowDegreeNormSq theta (uniformlyPermutedPlantEdgeLaw G)
        degreeCutoff =
      plantedLowDegreeNormSq theta G degreeCutoff := by
  unfold randomForcedLowDegreeNormSq randomForcedLowDegreeLikelihood
  unfold plantedLowDegreeNormSq plantedLowDegreeLikelihood
  rw [randomForcedLikelihood_uniformlyPermutedPlantEdgeLaw]

/-- Uniform injection of a fixed source graph gives the standard planted
law of its canonically padded graph. -/
theorem randomForcedLaw_uniformlyInjected_dirac_eq_plantedLaw_map_castLE
    {m n : Nat} (hfit : m <= n) (theta : BernoulliParameter)
    (G : SimpleGraph (Fin m)) :
    randomForcedLaw theta
        (uniformlyInjectedPlantLaw hfit
          (FiniteLaw.dirac (permutedPlantEdges G (Equiv.refl (Fin m))))) =
      plantedLaw theta (G.map (Fin.castLEEmb hfit)) := by
  rw [uniformlyInjected_dirac_eq_uniformlyPermuted_map_castLE]
  exact randomForcedLaw_uniformlyPermutedPlantEdgeLaw theta _

/-- The same identification remains exact after the paper's edge-resampling
noise operator. -/
theorem randomForcedLaw_retained_uniformlyInjected_dirac_eq_noisedPlantedLaw
    {m n : Nat} (hfit : m <= n) (theta : BernoulliParameter)
    (epsilon : NoiseRate) (G : SimpleGraph (Fin m)) :
    randomForcedLaw theta
        (retainedRandomPlantLaw (retentionParameter epsilon)
          (uniformlyInjectedPlantLaw hfit
            (FiniteLaw.dirac
              (permutedPlantEdges G (Equiv.refl (Fin m)))))) =
      noisedPlantedLaw theta epsilon (G.map (Fin.castLEEmb hfit)) := by
  rw [← resampleLaw_randomForcedLaw_eq_retainedRandomPlantLaw]
  rw [randomForcedLaw_uniformlyInjected_dirac_eq_plantedLaw_map_castLE]
  exact resampleLaw_plantedLaw_eq_noisedPlantedLaw theta epsilon _

/-- The fixed source edge set attached to a deterministic Appendix witness. -/
noncomputable def DeterministicPlantWitness.sourceEdges
    {D : Nat} {r gamma : Real} (W : DeterministicPlantWitness D r gamma)
    (n : Nat) : Finset (AmbientEdge (appendixPlantSize r n)) :=
  permutedPlantEdges (W.graph n)
    (Equiv.refl (Fin (appendixPlantSize r n)))

@[simp] theorem DeterministicPlantWitness.card_sourceEdges
    {D : Nat} {r gamma : Real} (W : DeterministicPlantWitness D r gamma)
    (n : Nat) :
    (W.sourceEdges n).card = (W.graph n).edgeFinset.card := by
  exact card_permutedPlantEdges _ _

/-- The paper's uniformly injected law for the witness is exactly the core
model's uniformly permuted law for the padded graph. -/
theorem DeterministicPlantWitness.deterministicAlternativeLaw_eq_plantedLaw
    {D : Nat} {r gamma : Real} (W : DeterministicPlantWitness D r gamma)
    (hr : r ∈ Set.Ioo (0 : Real) (1 / 2 : Real)) (c : Real) (n : Nat) :
    deterministicAlternativeLaw c (appendixPlantSize r)
        (fun k => appendixPlantSize_le_index hr.1 (by linarith [hr.2]) k)
        W.sourceEdges n =
      plantedLaw (sparseBernoulliParameter c n) (W.ambientGraph hr n) := by
  unfold deterministicAlternativeLaw deterministicInjectedPlantLaw
  simpa only [deterministicSourcePlantLaw,
    DeterministicPlantWitness.ambientGraph,
    DeterministicPlantWitness.ambientEmbedding] using
    randomForcedLaw_uniformlyInjected_dirac_eq_plantedLaw_map_castLE
      (appendixPlantSize_le_index hr.1 (by linarith [hr.2]) n)
      (sparseBernoulliParameter c n) (W.graph n)

/-- Exact noisy-law identification for the deterministic witness. -/
theorem DeterministicPlantWitness.deterministicNoisedAlternativeLaw_eq
    {D : Nat} {r gamma : Real} (W : DeterministicPlantWitness D r gamma)
    (hr : r ∈ Set.Ioo (0 : Real) (1 / 2 : Real))
    (epsilon : NoiseRate) (c : Real) (n : Nat) :
    deterministicNoisedAlternativeLaw epsilon c (appendixPlantSize r)
        (fun k => appendixPlantSize_le_index hr.1 (by linarith [hr.2]) k)
        W.sourceEdges n =
      noisedPlantedLaw (sparseBernoulliParameter c n) epsilon
        (W.ambientGraph hr n) := by
  unfold deterministicNoisedAlternativeLaw deterministicInjectedPlantLaw
  simpa only [deterministicSourcePlantLaw,
    DeterministicPlantWitness.ambientGraph,
    DeterministicPlantWitness.ambientEmbedding] using
    randomForcedLaw_retained_uniformlyInjected_dirac_eq_noisedPlantedLaw
      (appendixPlantSize_le_index hr.1 (by linarith [hr.2]) n)
      (sparseBernoulliParameter c n) epsilon (W.graph n)

end

end LowDegree
