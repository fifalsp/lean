import LowDegree.Asymptotics.PercolatedAcyclic
import LowDegree.Main
import LowDegree.Subcritical

/-!
# Model-facing forest-truncation endgame

This file supplies the analytic and finite-probability endgame of paper
Theorem 1.2.  The forest-truncated observation is an honest random-forcing
mixture, so its likelihood has a genuine second moment and the usual
finite-space chi-square bound applies.  A triangle inequality then compares
the original noised planted law with this truncated law, at a cost bounded by
the retained plant's cycle probability from Lemma 4.6.

The only input deliberately exposed below is convergence of the truncated
second moment.  Its proof is the remaining graph-sum argument over forest
supports; keeping that input explicit prevents the TV-only theorem from being
silently strengthened to a full noised-L2 assertion.
-/

namespace LowDegree

open Filter Topology

noncomputable section

namespace BoundedTreewidthPlantModel

/-- Second moment of the likelihood generated by the forest-truncated
retained plant. -/
noncomputable def forestTruncatedNormSq
    (M : BoundedTreewidthPlantModel) (noise : NoiseRate) (n : ℕ) : ℝ :=
  bernoulliInner (M.parameter n)
    (forestTruncatedLikelihood (M.parameter n) noise (M.plant n))
    (forestTruncatedLikelihood (M.parameter n) noise (M.plant n))

/-- TV distance from the forest-truncated observation law to the sparse
Erdős--Rényi null. -/
noncomputable def forestTruncatedTotalVariation
    (M : BoundedTreewidthPlantModel) (noise : NoiseRate) (n : ℕ) : ℝ :=
  (forestTruncatedObservationLaw (M.parameter n) noise (M.plant n)).tv
    (erdosRenyiLaw (M.parameter n))

/-- The forest-truncated likelihood is the pointwise likelihood ratio of its
actual observation law against the null law. -/
theorem forestTruncatedLikelihood_isLikelihoodRatio
    (M : BoundedTreewidthPlantModel) (noise : NoiseRate) (n : ℕ) :
    FiniteLaw.IsLikelihoodRatio
      (forestTruncatedObservationLaw (M.parameter n) noise (M.plant n))
      (erdosRenyiLaw (M.parameter n))
      (forestTruncatedLikelihood (M.parameter n) noise (M.plant n)) := by
  exact randomForcedLikelihood_isLikelihoodRatio
    (M.parameter n) (forestTruncatedRetainedPlantLaw noise (M.plant n))

/-- The standard second-moment certificate specialized to the concrete
forest-truncated model. -/
noncomputable def forestTruncatedSecondMomentCertificate
    (M : BoundedTreewidthPlantModel) (noise : NoiseRate) :
    SecondMomentCertificate :=
  SecondMomentCertificate.ofLikelihood
    (fun n ↦ forestTruncatedObservationLaw
      (M.parameter n) noise (M.plant n))
    (fun n ↦ erdosRenyiLaw (M.parameter n))
    (fun n ↦ forestTruncatedLikelihood
      (M.parameter n) noise (M.plant n))
    (M.forestTruncatedLikelihood_isLikelihoodRatio noise)

@[simp]
theorem forestTruncatedSecondMomentCertificate_normSq
    (M : BoundedTreewidthPlantModel) (noise : NoiseRate) (n : ℕ) :
    (M.forestTruncatedSecondMomentCertificate noise).normSq n =
      M.forestTruncatedNormSq noise n := by
  simp only [forestTruncatedSecondMomentCertificate,
    SecondMomentCertificate.ofLikelihood, forestTruncatedNormSq,
    FiniteLaw.expect, bernoulliInner, bernoulliExpectation,
    erdosRenyiLaw, bernoulliProductLaw]
  apply Finset.sum_congr rfl
  intro x _hx
  ring

@[simp]
theorem forestTruncatedSecondMomentCertificate_totalVariation
    (M : BoundedTreewidthPlantModel) (noise : NoiseRate) (n : ℕ) :
    (M.forestTruncatedSecondMomentCertificate noise).totalVariation n =
      M.forestTruncatedTotalVariation noise n :=
  rfl

/-- A forest-truncated second moment equal to `1 + o(1)` forces its actual
TV distance from the null to vanish. -/
theorem forestTruncatedTotalVariation_vanishes
    (M : BoundedTreewidthPlantModel) (noise : NoiseRate)
    (hnorm : TendsToOne (M.forestTruncatedNormSq noise)) :
    Vanishes (M.forestTruncatedTotalVariation noise) := by
  have hnorm' : TendsToOne
      (M.forestTruncatedSecondMomentCertificate noise).normSq := by
    have heq :
        (M.forestTruncatedSecondMomentCertificate noise).normSq =
          M.forestTruncatedNormSq noise := by
      funext n
      exact M.forestTruncatedSecondMomentCertificate_normSq noise n
    rw [heq]
    exact hnorm
  have htv :=
    (M.forestTruncatedSecondMomentCertificate noise).totalVariation_vanishes
      hnorm'
  simpa only [forestTruncatedSecondMomentCertificate_totalVariation] using htv

/-- Pointwise triangle/coupling bound for the concrete model. -/
theorem noisedTotalVariation_le_cycle_add_forestTruncated
    (M : BoundedTreewidthPlantModel) (noise : NoiseRate) (n : ℕ) :
    M.noisedTotalVariation noise n ≤
      retainedPlantCycleProbability noise (M.plant n) +
        M.forestTruncatedTotalVariation noise n := by
  change
    (noisedPlantedLaw (M.parameter n) noise (M.plant n)).tv
        (erdosRenyiLaw (M.parameter n)) ≤
      retainedPlantCycleProbability noise (M.plant n) +
        (forestTruncatedObservationLaw
          (M.parameter n) noise (M.plant n)).tv
          (erdosRenyiLaw (M.parameter n))
  calc
    (noisedPlantedLaw (M.parameter n) noise (M.plant n)).tv
        (erdosRenyiLaw (M.parameter n)) ≤
      (noisedPlantedLaw (M.parameter n) noise (M.plant n)).tv
          (forestTruncatedObservationLaw
            (M.parameter n) noise (M.plant n)) +
        (forestTruncatedObservationLaw
          (M.parameter n) noise (M.plant n)).tv
          (erdosRenyiLaw (M.parameter n)) :=
      FiniteLaw.tv_triangle _ _ _
    _ ≤ retainedPlantCycleProbability noise (M.plant n) +
        (forestTruncatedObservationLaw
          (M.parameter n) noise (M.plant n)).tv
          (erdosRenyiLaw (M.parameter n)) :=
      add_le_add_right
        (noisedPlantedLaw_tv_forestTruncated_le_cycleProbability
          (M.parameter n) noise (M.plant n)) _

/-- Concrete Theorem 1.2 endgame.  Lemma 4.6 makes the coupling cost vanish,
and convergence of the forest-truncated second moment controls the second
term.  The conclusion is exactly TV convergence of the original noised model.
-/
theorem subcriticalTotalVariation_vanishes_of_forestNorm
    (M : BoundedTreewidthPlantModel)
    (hc_one : M.backgroundDensity ≤ 1) (noise : NoiseRate)
    (hD : Omega
      (fun n ↦ (M.degreeCutoff n : ℝ))
      (fun n ↦ Real.log (n : ℝ)))
    (hlow : TendsToOne M.lowDegreeNormSq)
    (hforest : TendsToOne (M.forestTruncatedNormSq noise)) :
    Vanishes (M.noisedTotalVariation noise) := by
  let C : ForestTruncationCertificate :=
    { actualTV := M.noisedTotalVariation noise
      truncatedTV := M.forestTruncatedTotalVariation noise
      cycleProbability :=
        fun n ↦ retainedPlantCycleProbability noise (M.plant n)
      actualTV_nonneg := fun n ↦ FiniteLaw.tv_nonneg _ _
      actualTV_le := fun n ↦
        M.noisedTotalVariation_le_cycle_add_forestTruncated noise n }
  exact C.totalVariation_vanishes
    (PercolatedAcyclic.BoundedTreewidthPlantModel.retainedPlantCycleProbability_vanishes
      M hc_one noise hD hlow)
    (M.forestTruncatedTotalVariation_vanishes noise hforest)

end BoundedTreewidthPlantModel

end

end LowDegree
